# Production pins the immutable `X.Y.Z` release being deployed. The quickstart
# uses the moving `latest` tag separately and does not read this file. The
# local-build override (docker-compose.build.yml) builds with this same tag.
WARTABLE_TAG=0.1.0

# --- Local development -------------------------------------------------------
# Copy this file to `.env` beside the repository root. WarTable loads the
# nearest `.env` automatically at startup; existing environment variables win.
# Set WARTABLE_SKIP_DOTENV=1 to disable loading, or WARTABLE_ENV_FILE=/path/.env
# to choose a different file.
#
# Semantic knowledge search is optional. Enable it after starting an
# OpenAI-compatible embedding service (for example `ollama serve`).
Embeddings__Enabled=false
# Local source runs can use localhost. Docker Compose overrides this with
# host.docker.internal so the container can reach an Ollama server on the host.
# Embeddings__Endpoint=http://localhost:11434/v1
Embeddings__Model=embeddinggemma
Embeddings__Dimensions=768
Embeddings__MaxInputTokens=512
# Embeddings__Profile=
# Embeddings__ApiKey=
